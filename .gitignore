# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# personal GPX traces used for local testing - real location data, not for git history
reference/*.gpx

# unused duplicate of public/canvaskit.wasm (the one actually served at the web root) - leftover from an earlier setup attempt, not referenced by the app
/web/

# isolated git worktrees created by parallel Claude Code sessions - separate checkouts with their own branch/.git, not part of this repo's own history
.claude/worktrees/
